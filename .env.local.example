# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and keys from your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key bypasses row-level security; required by scripts/classify.ts
# to write holder_classifications and holder_aggregate_stats. Keep it secret —
# never expose it in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Etherscan ───────────────────────────────────────────────────────────────
# API key for supply, holders, and transfer history.
ETHERSCAN_API_KEY=

# ── Dune (optional, for supply/AUM history queries) ─────────────────────────
# Only needed if you run Dune-backed scripts locally.
DUNE_API_KEY=

# ── Chain RPC (optional) ─────────────────────────────────────────────────────
# Comma-separated JSON-RPC endpoints for the reconciliation tripwire's chain-supply
# reads and the Solana ATA resolver. Unset → public defaults (see src/lib/rwa/
# solana-rpc.ts, evm-rpc.ts, xrpl-rpc.ts). A keyed Helius/QuickNode URL first is
# strongly recommended for Solana — the public defaults rate-limit the resolver.
SOLANA_RPC_URLS=
XRPL_RPC_URLS=
